# Choose one provider: groq, openai, or xai
LLM_PROVIDER=groq

# Groq configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional xAI configuration
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Local retrieval models
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

CHUNK_SIZE=512
CHUNK_OVERLAP=64
BM25_TOP_K=50
VECTOR_TOP_K=50
FUSION_TOP_K=50
RRF_K=60
RERANK_TOP_K=5
MAX_CONTEXT_CHARS=12000

DATA_DIR=data
DOCS_DIR=docs
ALLOWED_DOCS_ROOT=docs
ALLOWED_ORIGINS=
OPENAI_USE_ENV_PROXY=false
