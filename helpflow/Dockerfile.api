FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/helpflow
WORKDIR /app
RUN addgroup --system --gid 10001 helpflow && adduser --system --uid 10001 --ingroup helpflow --home /home/helpflow helpflow
COPY requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt
COPY app ./app
COPY data/documents ./data/documents
COPY data/mock ./data/mock
COPY data/documents ./bundled-data/documents
COPY data/mock ./bundled-data/mock
COPY scripts ./scripts
RUN mkdir -p /app/data/backups /app/data/vector_index /app/data/logs /home/helpflow && chown -R helpflow:helpflow /app /home/helpflow
USER helpflow
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
